<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sets the GPU wired limit at boot. THE VALUE IS NO LONGER IN HERE; it is
  computed by /usr/local/libexec/set-iogpu-wired-limit.sh from hw.memsize
  (RAM minus 6 GiB up to 32 GB of RAM, minus 8 GiB above that):

      32 GB -> 26624      48 GB -> 40960      64 GB -> 57344

  WHY: until 2026-08-24 a fixed 26624 sat here -- the 32 GB value. Installed on
  a 48 GB machine this plist takes away 14 GiB of working set, and the follow-on
  error is silent: start-mlx_qwen3.8.sh checks `_WIRED_MB >= 40960` and falls
  back to PREFILL_STEP=512 below that, which stops the NAX path (qL >= 1024)
  from engaging -- with no warning. One value per RAM size in a version
  controlled file is precisely the kind of trap nobody notices, so the script
  does the arithmetic instead.

  The script clamps upwards. 48 GB with 45056 (44 GiB) ran into a kernel panic
  on 2026-08-21 -- macOS was left with ~2 GiB, without any warning
  (memoryPressure evaluates the compressor, not wired memory). See README and
  the script itself.

  Different value: a number in /etc/iogpu-wired-limit.conf. It is clamped too.

  INSTALLATION (needs sudo, changes system state). The helper script MUST be
  root:wheel and 755 -- a LaunchDaemon runs as root, and a writable script in
  that location would be a privilege escalation:

    sudo ./install-wired-limit-daemon.sh

  Verify:      sysctl iogpu.wired_limit_mb
               sudo /usr/local/libexec/set-iogpu-wired-limit.sh --dry-run
               log show --last 5m --predicate 'process == "sysctl"'
  Remove:      sudo ./install-wired-limit-daemon.sh --uninstall
  One-off:     sudo ./set-iogpu-wired-limit.sh
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.iogpu-wired-limit</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/set-iogpu-wired-limit.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/var/log/iogpu-wired-limit.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/iogpu-wired-limit.log</string>
</dict>
</plist>
