+        # ── Role compatibility (local patch, 2026-08-17) ──────────────────────
+        # Qwen3.8's chat_template accepts ONLY system/user/assistant/tool and
+        # raises raise_exception('Unexpected message role.') on anything else —
+        # an HTTP 500 in mlx-vlm. Qwen3.6 was more tolerant and additionally
+        # accepted 'developer'. Switching models therefore breaks every client
+        # that sends either of the two legacy roles (with Hermes,
+        # _VALID_API_ROLES lets both 'function' and 'developer' through).
+        #
+        # EXACT CAUSE (isolated 2026-08-17): the request schema allows
+        # user/assistant/system/developer/tool (server/schemas.py:279), the
+        # Qwen3.8 template accepts system/user/assistant/tool. That
+        # intersection lets EXACTLY ONE role pass validation and then fall
+        # into the template's exception: 'developer'. Everything else
+        # (function, session_meta, admin) is rejected by the schema with an
+        # HTTP 422 and never reaches the template at all.
+        #
+        # Both mappings are semantically exact, not a guess:
+        #   developer -> system : 'developer' is OpenAI's newer name for the
+        #                         system role. Only applied when the template
+        #                         does not know the role itself (Qwen3.6 does,
+        #                         and treats it exactly like system, line 47).
+        #                         THAT one is the fix for the 500.
+        #   function  -> tool    : 'function' is the predecessor role that
+        #                         'tool' replaced. Unreachable today, because
+        #                         the schema throws 422 first — kept on
+        #                         purpose, in case the schema is ever widened.
+        # Everything else still falls through and throws — deliberately, so
+        # that real errors stay visible instead of being quietly reinterpreted.
+        # Disable with: MLX_VLM_ROLE_COMPAT=0
+        if os.environ.get("MLX_VLM_ROLE_COMPAT", "1").lower() not in (
+            "0", "false", "no", "off",
+        ):
+            _dev_native = _template_references_kw(template_processor, "developer")
+            _out, _swaps = [], []
+            for _msg in messages:
+                if isinstance(_msg, dict):
+                    _role = _msg.get("role")
+                    if _role == "function":
+                        _msg = {**_msg, "role": "tool"}
+                        _swaps.append("function->tool")
+                    elif _role == "developer" and not _dev_native:
+                        _msg = {**_msg, "role": "system"}
+                        _swaps.append("developer->system")
+                _out.append(_msg)
+            if _swaps:
+                logging.getLogger(__name__).info(
+                    "role compat: remapped %s (set MLX_VLM_ROLE_COMPAT=0 to disable)",
+                    ", ".join(sorted(set(_swaps))),
+                )
+                messages = _out
+
