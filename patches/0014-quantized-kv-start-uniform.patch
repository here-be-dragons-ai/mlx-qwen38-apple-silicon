@@ -782,14 +782,32 @@
 
     use_turbo = kv_bits is not None and turboquant_enabled(kv_bits, kv_quant_scheme)
 
-    defer_turbo = (
-        use_turbo and quantized_kv_start > 0 and prefill_length < quantized_kv_start
+    # ── quantized_kv_start now applies to uniform as well (local patch 0014)
+    # Upstream evaluates quantized_kv_start only inside the TurboQuant branch
+    # (defer_turbo). On the uniform path — i.e. --kv-bits without
+    # --kv-quant-scheme turboquant, our default — quantisation started at
+    # token 0, no matter what --quantized-kv-start said. That only became
+    # visible once DFlash 2 became the default: the start script sets
+    # MLX_VLM_SPECULATIVE_BATCH=1 for it, so the batch path now runs in
+    # normal operation rather than only at MAX_NUM_SEQS > 1.
+    # Semantics as in defer_turbo: the decision is taken ONCE, when the cache
+    # is created, from the prompt length -- it does not switch in the middle
+    # of a request. Short turns therefore stay f16, long ones get quantised.
+    # CAREFUL: this makes the cache TYPE depend on the prompt length. At
+    # MAX_NUM_SEQS > 1 two concurrent requests can end up with different
+    # types that `extend` cannot merge — defer_turbo upstream has exactly
+    # that property already. We run MAX_NUM_SEQS=1.
+    # Rollback: QUANT_KV_START=0 (the branch is then inert, as before).
+    defer_quant = (
+        kv_bits is not None
+        and quantized_kv_start > 0
+        and prefill_length < quantized_kv_start
     )
 
     def _make_quant_cache(lp):
+        if defer_quant:
+            return cache.BatchKVCache(lp)
         if use_turbo:
-            if defer_turbo:
-                return cache.BatchKVCache(lp)
             return BatchTurboQuantKVCache(
                 lp, bits=kv_bits, key_bits=kv_key_bits, value_bits=kv_value_bits
             )
